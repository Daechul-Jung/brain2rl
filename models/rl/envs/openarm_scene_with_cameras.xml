<mujoco model="openarm_scene_with_cameras">
  <!-- include vendor robot (bimanual) -->
  <include file="../../../../external/openarm_mujoco/v1/openarm_bimanual.xml"/>

  <!-- your task/world -->
  <option timestep="0.002"/>

  <worldbody>
    <!-- Add wrist-mounted cameras to the left arm -->
    <body name="left_wrist_camera" pos="0 0 0" quat="1 0 0 0">
      <camera name="left_wrist_cam" mode="track" fovy="60.0" 
              pos="0 0 0.05" quat="0.7071068 0 0.7071068 0"/>
      <site name="left_wrist_cam_site" pos="0 0 0.05" quat="0.7071068 0 0.7071068 0"/>
    </body>
    
    <!-- Attach camera to left wrist -->
    <body name="left_wrist_camera_attach" pos="0 0 0" quat="1 0 0 0">
      <camera name="left_wrist_cam_attach" mode="track" fovy="60.0" 
              pos="0 0 0.02" quat="0.7071068 0 0.7071068 0"/>
      <site name="left_wrist_cam_attach_site" pos="0 0 0.02" quat="0.7071068 0 0.7071068 0"/>
    </body>

    <!-- Multiple cups for more complex tasks -->
    <body name="cup1" pos="0.35 0.00 0.75">
      <geom name="cup1_geom" type="cylinder" size="0.03 0.06"
            rgba="0.6 0.3 0.1 1" friction="0.8 0.1 0.1" contype="1" conaffinity="1"/>
      <freejoint/>
      <site name="cup1_top" pos="0 0 0.06"/>
    </body>
    
    <body name="cup2" pos="0.40 0.10 0.75">
      <geom name="cup2_geom" type="cylinder" size="0.025 0.05"
            rgba="0.3 0.6 0.1 1" friction="0.8 0.1 0.1" contype="1" conaffinity="1"/>
      <freejoint/>
      <site name="cup2_top" pos="0 0 0.05"/>
    </body>
    
    <body name="cup3" pos="0.30 -0.08 0.75">
      <geom name="cup3_geom" type="cylinder" size="0.035 0.07"
            rgba="0.1 0.3 0.6 1" friction="0.8 0.1 0.1" contype="1" conaffinity="1"/>
      <freejoint/>
      <site name="cup3_top" pos="0 0 0.07"/>
    </body>

    <!-- Target zone for placing cups -->
    <body name="target_zone" pos="0.45 0.00 0.75">
      <geom name="target_zone_geom" type="cylinder" size="0.08 0.02"
            rgba="0.8 0.8 0.2 0.3" friction="0.1 0.1 0.1" contype="0" conaffinity="0"/>
      <site name="target_zone_center" pos="0 0 0.02"/>
    </body>
  </worldbody>

  <!-- Add sensors for cup detection -->
  <sensor>
    <framepos name="cup1_pos" objtype="site" objname="cup1_top" />
    <framepos name="cup2_pos" objtype="site" objname="cup2_top" />
    <framepos name="cup3_pos" objtype="site" objname="cup3_top" />
    <framepos name="target_zone_pos" objtype="site" objname="target_zone_center" />
  </sensor>
</mujoco>

